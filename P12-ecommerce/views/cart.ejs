<%- include('partials/header') %>
<h1>Your Cart</h1>
<% if (cart.length === 0) { %>
  <p>Your cart is empty. <a href="/">Go shopping</a></p>
<% } else { %>
  <table>
    <tr><th>Product</th><th>Price</th><th>Qty</th><th>Subtotal</th><th></th></tr>
    <% cart.forEach(i => { %>
      <tr>
        <td><%= i.name %></td><td>Rs. <%= i.price %></td><td><%= i.qty %></td><td>Rs. <%= i.price * i.qty %></td>
        <td><form action="/cart/remove/<%= i.id %>" method="POST"><button>Remove</button></form></td>
      </tr>
    <% }) %>
  </table>
  <h3>Total: Rs. <%= total %></h3>
  <a href="/checkout"><button>Proceed to Payment</button></a>
<% } %>
<%- include('partials/footer') %>
